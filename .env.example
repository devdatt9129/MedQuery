# ---------- shared ----------
OPENAI_API_KEY=

# ---------- backend ----------
LLM_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBEDDINGS_PROVIDER=openai

# Chroma persistence (compose overrides to /data/chroma inside the container)
CHROMA_DIR=./data/chroma

# Local compose talks to the redis service below
REDIS_URL=redis://redis:6379

# CORS (local dev)
FRONTEND_ORIGIN=http://localhost:3000

# Turn off Chroma telemetry noise (optional)
CHROMA_TELEMETRY_IMPLEMENTATION=none
CHROMA_ANONYMIZED_TELEMETRY=false
CHROMADB_TELEMETRY_IMPLEMENTATION=none

# ---------- frontend ----------
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000